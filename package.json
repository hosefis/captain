{
  "name": "create-captain",
  "version": "0.2.0",
  "description": "CAPTAIN — Create Apps Properly: Templates, Adapters, Integrations, Now",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hosefis/captain.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "captain": "./dist/cli.js",
    "create-captain": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "compatibility.json",
    "doc-versions.json"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "canary:packed": "node scripts/run-package-canary.mjs packed",
    "canary:published": "node scripts/run-package-canary.mjs published",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:release": "node --test scripts/release-version.test.mjs",
    "test:matrix": "vitest run src/integration/tier-a-golden.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
