# CAPTAIN — copy to .env.local (never commit secrets)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend ({backend})
API_BASE_URL=http://localhost:4000

# Auth ({auth})
# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Better Auth
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=

# WorkOS
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_REDIRECT_URI=

# Convex (when backend=convex)
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=

# Supabase (when backend=supabase)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Firebase (when backend=firebase)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# i18n
DEFAULT_LOCALE={defaultLocale}
